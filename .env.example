# ==============================================================================
# CONFIGURAÇÃO DE INTEGRAÇÃO - CANVAS LMS & GOOGLE CALENDAR
# ==============================================================================
# Renomeie este arquivo para .env e preencha com seus dados reais.

# 1. Canvas LMS API
# Exemplo: https://senac.instructure.com ou https://canvas.instructure.com
CANVAS_API_URL=https://canvas.instructure.com
# Gere seu token no Canvas em: Conta > Configurações > Tokens de Acesso Aprovados > + Novo Token de Acesso
CANVAS_API_TOKEN=seu_token_de_acesso_canvas_aqui

# 2. Google Calendar API (Opcional se for utilizar apenas a importação do arquivo .ics)
# Use 'primary' para a agenda principal ou o ID de uma agenda secundária criada para a faculdade
CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json

# 3. Preferências Regionais & Armazenamento
TIMEZONE=America/Sao_Paulo
OUTPUT_DIR=./estudos_canvas
YEAR=2026
